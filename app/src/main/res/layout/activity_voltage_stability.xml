<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bat_monitor_card"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/vsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="22sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voltage Stability Monitor"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimasi kestabilan tegangan, bukan diagnosis kerusakan baterai"
                android:textSize="11sp"
                android:textColor="@color/bat_monitor_label"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bat_card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="15dp"
                        android:background="@color/bat_monitor_header"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Metrik Stabilitas"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/bat_monitor_header"
                        android:layout_marginStart="8dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/vsConditionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Menunggu"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/bat_monitor_label"
                        android:background="@drawable/bat_badge_stopped_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/vsMetricsLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:lineSpacingExtra="3dp"/>

                    <TextView
                        android:id="@+id/vsMetricsRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/vsStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Menunggu data baterai"
                    android:textSize="11sp"
                    android:textColor="@color/bat_monitor_label"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estimasi resistansi efektif berasal dari perubahan arus dan tegangan yang memenuhi syarat. Nilainya bukan resistansi internal baterai yang sesungguhnya."
                    android:textSize="10sp"
                    android:textColor="@color/bat_monitor_label"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bat_card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="15dp"
                        android:background="@color/bat_monitor_header"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grafik Historis"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/bat_monitor_header"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Charging"
                        android:textSize="11sp"
                        android:textColor="@color/bat_condition_charging"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Discharging"
                        android:textSize="11sp"
                        android:textColor="@color/bat_condition_discharging"
                        android:layout_marginStart="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Idle / Recovery"
                        android:textSize="11sp"
                        android:textColor="@color/bat_condition_idle"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/vsRangeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/vsRange0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5m"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="@color/bat_monitor_label"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/vsRange1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30m"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="@color/bat_monitor_label"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/vsRange2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1j"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="@color/bat_monitor_label"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/vsRange3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="6j"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="@color/bat_monitor_label"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/vsRange4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="24j"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="@color/bat_monitor_label"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <exp.ftxt.ui.VoltageStabilityChartView
                    android:id="@+id/vsChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/vsHistoryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Memuat riwayat…"
                    android:textSize="10sp"
                    android:textColor="@color/bat_monitor_label"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
