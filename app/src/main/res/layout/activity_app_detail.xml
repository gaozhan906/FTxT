<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bat_monitor_card"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/appDetailBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="22sp"
            android:textColor="?android:attr/textColorPrimary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bat_monitor_header"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/appDetailPkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/bat_monitor_label"
                android:singleLine="true"/>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/appDetailTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="fill"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/appDetailPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bat_monitor_card">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/appDetailOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailUninstall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hapus"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bagikan APK"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info Sistem"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailForceStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paksa Berhenti"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailForceStopShizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shizuku"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailClearCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hapus Cache"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/appDetailClearData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hapus Data"
                android:textSize="12sp"/>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
