<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    android:scrollbars="vertical"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/appdataSwitch"
                android:text="Overlay Aplikasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <CheckBox
                android:id="@+id/appdataLockSwitch"
                android:text="Kunci Posisi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/appdataPermissionCard"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="#22FF9800"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/appdataPermissionText"
                android:text="Akses penggunaan aplikasi diperlukan untuk menampilkan aplikasi yang sedang memakai data."
                android:textSize="12sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/appdataPermissionBtn"
                android:text="Buka Izin Akses Penggunaan"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <TextView
            android:id="@+id/appdata_sectionDisplayHeader"
            android:text="▾ Tampilan"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/appdata_sectionDisplay"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/appdataShowIconCheck"
                    android:text="Tampilkan Ikon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <CheckBox
                    android:id="@+id/appdataShowIdleCheck"
                    android:text="Tampilkan saat kosong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:text="Unit:"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioGroup
                    android:id="@+id/appdataUnitGroup"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <RadioButton
                        android:id="@+id/appdataUnitKb"
                        android:text="KB/s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RadioButton
                        android:id="@+id/appdataUnitBps"
                        android:text="bps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </RadioGroup>

                <CheckBox
                    android:id="@+id/appdataUnitTrimCheck"
                    android:text="Pangkas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <CheckBox
                android:id="@+id/appdataDecimalCheck"
                android:text="Desimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/appdataSizeLabel"
                android:text="Ukuran Teks: 12"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"/>

            <SeekBar
                android:id="@+id/appdataSizeSeekBar"
                android:max="100"
                android:progress="12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/appdataBoldCheck"
                    android:text="Bold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <CheckBox
                    android:id="@+id/appdataItalicCheck"
                    android:text="Italic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/appdataColorPreview"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FF0000"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:text="Nilai"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/appdataLabelColorPreview"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#00FF00"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:text="Nama"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/appdataShadowColorPreview"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FF0000"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:text="Shadow"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/appdataBgColorPreview"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FF0000"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:text="Background"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp"
            android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/appdata_sectionBehaviorHeader"
            android:text="▾ Perilaku"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/appdata_sectionBehavior"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioGroup
                android:id="@+id/appdataModeGroup"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/appdataModeTop"
                    android:text="Top Talkers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <RadioButton
                    android:id="@+id/appdataModeForeground"
                    android:text="Aplikasi Depan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

            </RadioGroup>

            <TextView
                android:id="@+id/appdataRowsLabel"
                android:text="Jumlah Aplikasi: 3"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/appdataRowsSeekBar"
                android:max="4"
                android:progress="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:text="Update="
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataIntervalValue"
                    android:text="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="#555555"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="36dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="s"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:text="Ambang="
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataThresholdValue"
                    android:text="1 KB/s"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="#555555"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="64dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/appdataHoldLabel"
                android:text="Tahan setelah berhenti: 3 detik"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <SeekBar
                android:id="@+id/appdataHoldSeekBar"
                android:max="10"
                android:progress="3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <View
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp"
            android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/appdata_sectionPositionHeader"
            android:text="▾ Posisi"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/appdata_sectionPosition"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:text="Kontrol Posisi"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdata_posCoordDisplay"
                    android:text="540X1200"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <TextView
                android:id="@+id/appdata_active_preset_label"
                android:textSize="12sp"
                android:textColor="#888888"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/appdata_posXLabel"
                        android:text="X: 0.50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <SeekBar
                        android:id="@+id/appdata_posXSeekBar"
                        android:max="1000"
                        android:progress="500"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/appdata_posYLabel"
                        android:text="Y: 0.12"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <SeekBar
                        android:id="@+id/appdata_posYSeekBar"
                        android:max="1000"
                        android:progress="120"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/appdata_btnMinus"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_minus"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"/>

                        <ImageButton
                            android:id="@+id/appdata_btnUp"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_arrow_up"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"/>

                        <ImageButton
                            android:id="@+id/appdata_btnPlus"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_plus"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"/>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/appdata_btnLeft"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_arrow_left"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"/>

                        <TextView
                            android:id="@+id/appdata_dpadInterval"
                            android:layout_width="60dp"
                            android:layout_height="35dp"
                            android:gravity="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:clickable="true"
                            android:focusable="true"/>

                        <ImageButton
                            android:id="@+id/appdata_btnRight"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"/>

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/appdata_btnDown"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_arrow_down"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"/>

                </LinearLayout>

            </LinearLayout>

            <CheckBox
                android:id="@+id/appdataSafeArea"
                android:text="Gunakan Area Aman"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <View
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp"
            android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/appdata_sectionShadowHeader"
            android:text="▾ Shadow"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/appdata_sectionShadow"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/appdataShadowSwitch"
                android:text="Shadow"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/shadowConfigAppData"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/appdataShadowBlurLabel"
                    android:text="Blur Shadow: 5"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataShadowBlurSeekBar"
                    android:max="50"
                    android:progress="5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataShadowOffsetXLabel"
                    android:text="Shadow X: 3"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataShadowOffsetXSeekBar"
                    android:max="120"
                    android:progress="63"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataShadowOffsetYLabel"
                    android:text="Shadow Y: 3"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataShadowOffsetYSeekBar"
                    android:max="120"
                    android:progress="63"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp"
            android:layout_width="match_parent"/>

        <TextView
            android:id="@+id/appdata_sectionBackgroundHeader"
            android:text="▾ Background"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/appdata_sectionBackground"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/appdataBgSwitch"
                android:text="Background"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/bgConfigAppData"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/appdataBgPaddingLabel"
                    android:text="Ukuran Background: 8"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataBgPaddingSeekBar"
                    android:max="80"
                    android:progress="8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataBgOffsetXLabel"
                    android:text="Offset X: 0"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataBgOffsetXSeekBar"
                    android:max="120"
                    android:progress="60"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataBgOffsetYLabel"
                    android:text="Offset Y: 0"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataBgOffsetYSeekBar"
                    android:max="120"
                    android:progress="60"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataBgMarginLabel"
                    android:text="Margin: 0"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataBgMarginSeekBar"
                    android:max="30"
                    android:progress="0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/appdataBgRadiusLabel"
                    android:text="Radius: 0"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>

                <SeekBar
                    android:id="@+id/appdataBgRadiusSeekBar"
                    android:max="50"
                    android:progress="0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
