<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/appmgr_card_margin"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/appmgr_card_margin"
    android:layout_marginBottom="4dp"
    android:background="@drawable/appmgr_item_bg"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/itemAppIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Ikon aplikasi" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/appmgr_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemAppMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/appmgr_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itemAppBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/appmgr_tag_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/itemAppCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Pilih aplikasi"
        android:gravity="center"
        app:buttonTint="@color/appmgr_accent" />

</LinearLayout>
