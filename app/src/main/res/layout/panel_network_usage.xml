<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkSubUsagePage"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/networkSubTabUsage"
            android:text="Pemakaian"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/usage_accent"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/networkSubTabTools"
            android:text="Alat"
            android:textSize="13sp"
            android:textColor="@color/usage_filter_unselected_text"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/networkUsageTabUsage"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/networkUsageRange"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/networkUsagePeriodFilter"
                    android:text="Hari ini"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/usage_accent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingHorizontal="4dp"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/networkUsageNetworkFilter"
                    android:text="Semua"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/usage_accent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:paddingHorizontal="4dp"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/networkUsageHistoryToggle"
                    android:text="Riwayat &#8250;"
                    android:textSize="12sp"
                    android:textColor="@color/usage_accent"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:minWidth="48dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="always"
                    android:scrollbars="vertical"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/networkUsageContent"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <TextView
                            android:text="Total"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/networkUsageTotal"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/networkUsageRx"
                                android:textSize="13sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/networkUsageTx"
                                android:textSize="13sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:layout_marginStart="14dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/networkUsageAverage"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/networkUsagePeak"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/networkUsagePartialNote"
                            android:textSize="11sp"
                            android:textColor="@color/usage_warning"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/networkUsageChartTitle"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="22dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <exp.ftxt.features.network_stats.usage.UsageChartView
                            android:id="@+id/networkUsageChart"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"/>

                        <TextView
                            android:id="@+id/networkUsageChartLegend"
                            android:text="Hijau: unduh   Biru: unggah"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginTop="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <include
                            android:id="@+id/networkUsageDonutCard"
                            layout="@layout/view_usage_donut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/networkUsageAppsTitle"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginTop="22dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/networkUsageAppsList"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>

                        <TextView
                            android:id="@+id/networkUsageAppsEmpty"
                            android:text="Tidak ada rincian aplikasi."
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"/>

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

                <LinearLayout
                    android:id="@+id/networkUsageLoading"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Memuat data pemakaian..."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/networkUsagePermission"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <TextView
                        android:text="Akses penggunaan diperlukan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Izinkan FTxT membaca statistik penggunaan jaringan agar ringkasan dan grafik dapat ditampilkan."
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/networkUsagePermissionButton"
                        android:text="Buka pengaturan"
                        android:layout_marginTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/networkUsageError"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/networkUsageErrorText"
                        android:text="Gagal memuat data pemakaian."
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/networkUsageRetry"
                        android:text="Coba lagi"
                        android:layout_marginTop="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <include
            android:id="@+id/networkUsageTabTools"
            layout="@layout/panel_network_tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
