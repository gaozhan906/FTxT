<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel_network"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/networkSubSpeedPage"
            layout="@layout/panel_network_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <include
            android:id="@+id/networkSubUsagePage"
            layout="@layout/panel_network_usage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/netBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="45dp"
        app:menu="@menu/menu_network_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="18dp"
        app:itemTextAppearance="@style/NetNavTextAppearance"
        app:itemTextColor="@color/net_nav_item_color"
        app:itemIconTint="@color/net_nav_item_color"
        app:itemPaddingTop="1dp"
        app:itemPaddingBottom="2dp"
        app:itemActiveIndicatorStyle="@style/NetNavActiveIndicator"/>

</LinearLayout>
