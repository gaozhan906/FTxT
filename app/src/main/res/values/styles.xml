<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="SettingsPopupAnimation" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/settings_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/settings_popup_exit</item>
    </style>

    <style name="SettingsPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupAnimationStyle">@style/SettingsPopupAnimation</item>
    </style>

    <style name="TooltipFadeAnimation" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/tooltip_fade_in</item>
        <item name="android:windowExitAnimation">@anim/tooltip_fade_out</item>
    </style>

    <style name="BatNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="BatNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="MemNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="MemNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="NetNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="NetNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="AppMgrNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/appmgr_accent_container</item>
    </style>

    <style name="AppMgrNavTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="AppMgrToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/appmgr_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppMgrCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/appmgr_surface</item>
        <item name="cardCornerRadius">@dimen/appmgr_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/appmgr_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/appmgr_ripple</item>
    </style>

    <style name="AppMgrSummaryCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/appmgr_ripple</item>
    </style>

    <style name="AppMgrCardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/appmgr_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppMgrMetric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/appmgr_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppMgrBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/appmgr_label</item>
    </style>

    <style name="AppMgrCaption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/appmgr_label</item>
    </style>

    <style name="AppMgrAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/appmgr_accent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="iconTint">@color/appmgr_accent</item>
    </style>

</resources>

